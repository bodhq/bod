# Produkční nastavení (pro nasazení přes docker-compose.yml)
DOMAIN=localhost

# Webová aplikace (Next.js)
# Pro produkci nastavte na reálnou doménu, např. https://bod.skola.cz
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Připojení k lokální (nebo produkční) PostgreSQL databázi — plně integrální pro API.
DATABASE_URL=postgresql://bod:bod@localhost:5432/bod
POSTGRES_USER=bod
POSTGRES_PASSWORD=bod
POSTGRES_DB=bod
