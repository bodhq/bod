# Produkční nastavení (pro nasazení přes docker-compose.yml)
DOMAIN=localhost

# Připojení k lokální (nebo produkční) PostgreSQL databázi — plně integrální pro API.
DATABASE_URL=postgresql://bod:bod@localhost:5433/bod
POSTGRES_PORT=5433
POSTGRES_USER=bod
POSTGRES_PASSWORD=bod
POSTGRES_DB=bod

COOKIE_SECURE=true
# Pro lokální vývoj přes HTTP nastavte COOKIE_SECURE=false.
ALLOWED_ORIGINS=["http://localhost:3000"]
SESSION_IDLE_DAYS=7
SESSION_REFRESH_THRESHOLD_DAYS=2
REDIS_URL=redis://localhost:6379/0

# Soubory školy na jejím serveru. Relativní cesta se počítá od kořene projektu.
MEDIA_ROOT=var/media
