# Lokální vývoj. Školní instalace vytváří vlastní config.env přes bod install.
DOMAIN=localhost

# Připojení k lokální (nebo produkční) PostgreSQL databázi — plně integrální pro API.
DATABASE_URL=postgresql://bod:bod@localhost:5433/bod
# Pouze pro produkční Compose: host služby db, vnitřní port 5432.
# Při změně údajů POSTGRES_* aktualizujte i tuto URL (heslo URL-enkódujte).
DOCKER_DATABASE_URL=postgresql://bod:bod@db:5432/bod
POSTGRES_PORT=5433
POSTGRES_USER=bod
POSTGRES_PASSWORD=bod
POSTGRES_DB=bod

# Vývoj přes HTTP; produkční Compose vynucuje COOKIE_SECURE=true.
COOKIE_SECURE=false
# V produkci nastavte veřejný HTTPS původ, např. ["https://skola.example.cz"].
ALLOWED_ORIGINS=["http://localhost:3000"]
SESSION_IDLE_DAYS=7
SESSION_REFRESH_THRESHOLD_DAYS=2
SESSION_ACTIVITY_INTERVAL_SECONDS=300
# Jen chybná přihlášení; sdílená školní IP může přihlašovat více účtů.
LOGIN_IP_MAX_FAILURES=100
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
REDIS_URL=redis://localhost:6379/0

# Soubory školy na jejím serveru. Relativní cesta se počítá od kořene projektu.
MEDIA_ROOT=var/media
