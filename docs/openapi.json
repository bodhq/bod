          "class_id",
          "subject",
          "teacher_id",
          "room",
          "day",
          "start_time",
          "end_time"
        ],
        "title": "LessonPublic",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9_.]+$",
