        "title": "AuthSessionPublic",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "AUTH_INVALID_CREDENTIALS",
          "AUTH_UNAUTHENTICATED",
          "AUTH_ACCOUNT_LOCKED",
          "AUTH_LOGIN_UNAVAILABLE",
          "AUTH_SESSION_NOT_FOUND",
          "RESOURCE_NOT_FOUND",
          "VALIDATION_ERROR",
