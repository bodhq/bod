\newcommand{\MakeTitlePage}{%
\begin{titlepage}
  \newgeometry{left=2.5cm,right=1.5cm,top=2.5cm,bottom=3.5cm}
  \centering
  \sffamily

  \MakeLogoSPSE

  \vspace{2.8cm}
  {\fontsize{16pt}{20pt}\selectfont\bfseries \MakeUppercase\WorkTypeText\par}
  \vspace{26pt}
  {\fontsize{16pt}{20pt}\selectfont Téma: \WorkTitle \par}

  \vfill
  \raggedright
  \setlength{\tabcolsep}{1em}%
  \begin{tabular}{@{}ll@{}}
    \large\textbf{\WorkAuthorLabel} & \large\bfseries\WorkAuthor \\[6pt]
    \large\textbf{Třída:} & \large\bfseries\WorkClass \\[6pt]
    \large\textbf{Vedoucí práce:} & \large\bfseries\WorkSupervisor \\[6pt]
    \large\textbf{Dne:} & \large\bfseries\WorkDate \\[6pt]
    \large\textbf{Hodnocení:} & \large\bfseries\WorkEvaluation
  \end{tabular}

  \restoregeometry
\end{titlepage}%
}

% ============================================================
% POMOCNÉ MAKRO PRO NEČÍSLOVANÉ KAPITOLY V OBSAHU
% ============================================================
\newcommand{\tocchapter}[1]{\chapter*{#1}\addcontentsline{toc}{chapter}{#1}}
\newcommand{\tocsection}[1]{\section*{#1}\addcontentsline{toc}{chapter}{#1}}

% ============================================================
% JEDNODUCHÉ STYLY PRO SEZNAMY
% ============================================================
\setlist[itemize]{leftmargin=1.5em,itemsep=0.2em,topsep=0.3em}
\setlist[enumerate]{leftmargin=1.8em,itemsep=0.2em,topsep=0.3em}

% ============================================================
% PROSTŘEDÍ PRO DOSLOVNOU CITACI (dle školního zadání)
% ============================================================
\newenvironment{citacebase}
  {
    \begin{list}{}
      {
        \leftmargin=1cm    % odsazení zleva
        \rightmargin=1cm   % odsazení zprava
      }
    \item\relax
    \setstretch{1.3}      % stejné řádkování jako v textu
    \normalsize           % stejná velikost písma
  }
  {
    \end{list}
}
\newenvironment{citace}
  {
    \begin{citacebase}
    \itshape              % kurzíva
  }
  {
    \end{citacebase}
}
\newenvironment{citacePlain}
  {
    \begin{citacebase}
  }
  {
    \end{citacebase}
}
