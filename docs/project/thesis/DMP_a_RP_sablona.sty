% DMP_a_RP_sablona.sty
% ------------------------------------------------------------
% Stylový soubor pro maturitní / ročníkovou práci.
% Obsahuje pouze formátování a společná nastavení.
% Vlastní text práce patří do .tex souboru.
% ------------------------------------------------------------

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{DMP_a_RP_sablona}[2026/06/15 školní šablona]

% ============================================================
% BALÍČKY A JEJICH ÚČEL
% ============================================================

% geometry = nastavení okrajů stránky a rozměrů tiskové plochy.
% Používáme hodnoty blízké školnímu vzoru: nahoře 2,5 cm, dole 3,5 cm,
% vlevo 2,5 cm, vpravo 1,5 cm.
\RequirePackage[a4paper,left=2.5cm,right=1.5cm,top=2.5cm,bottom=3.5cm]{geometry}

\RequirePackage{iftex}

\ifPDFTeX
  % fontenc = správné dělení a výstup českých znaků v PDF.
  \RequirePackage[T1]{fontenc}

  % inputenc = vstupní kódování zdrojového souboru (pro pdfLaTeX).
  % V moderních instalacích je často implicitní, ale ponecháváme jej
  % kvůli kompatibilitě a jednoduchému použití studenty.
  \RequirePackage[utf8]{inputenc}

  % babel = české dělení slov, názvy kapitol, obsahy, datum atd.
  \RequirePackage[czech]{babel}

  % newtxtext/newtxmath = patkové písmo velmi blízké Times New Roman
  % a odpovídající matematické fonty. Je to praktičtější než ruční
  % nastavování Times v celé šabloně a výsledkem je sazba podobná Wordu.
  \RequirePackage{newtxtext,newtxmath}
\else
  \RequirePackage{fontspec}
  \RequirePackage{polyglossia}
  \setdefaultlanguage{czech}

  % fonty (varianta Times)
  \setmainfont{Times New Roman}
  \setsansfont{Arial}
\fi


% setspace = snadné nastavení řádkování.
\RequirePackage{setspace}

% úprava zobrazování obsahu.
\RequirePackage{tocloft}
\newlistof{appendixentry}{app}{Seznam příloh}
\newcommand{\appendixentry}[1]{%
  \refstepcounter{appendixentry}
  \addcontentsline{app}{appendixentry}{#1}
}
\makeatletter
\newcommand{\listofappendices}{%
  \@starttoc{app}
}
\makeatother

% titlesec = přesné nastavení vzhledu nadpisů (velikost, řez, mezery).
\RequirePackage{titlesec}

% graphicx = vkládání obrázků a loga školy.
\RequirePackage{graphicx}

% hyperref = klikatelné odkazy v PDF, obsah, odkazy na kapitoly,
% seznamy obrázků/tabulek a bibliografii.
\RequirePackage[hidelinks,unicode]{hyperref}

% biblatex = moderní správa citací a seznamu literatury.
% backend=biber znamená, že se bibliografie zpracuje pomocí Biberu.
% style=numeric odpovídá číselnému způsobu citování.
\RequirePackage[backend=biber,style=numeric,sorting=none]{biblatex}

% newfloat = definice vlastního plovoucího prostředí "graph" pro grafy.
% Díky tomu lze generovat i Seznam grafů.
\RequirePackage{newfloat}

% enumitem = kontrola vzhledu seznamů (itemize, enumerate).
\RequirePackage{enumitem}

% amsmath = kvalitnější matematická sazba, zejména rovnice, align apod.
\RequirePackage{amsmath}

% booktabs = elegantnější tabulky bez zbytečných svislých čar.
% Není povinný, ale je vhodný pro odborné práce.
\RequirePackage{booktabs}

% array = rozšířené možnosti typografie sloupců v tabulkách.
\RequirePackage{array}

% multirow = vícerádkové buňky v tabulkách.
\RequirePackage{multirow}

% longtable = tabulky přetékající přes více stran.
\RequirePackage{longtable}

% xcolor = barvy; necháváme pouze pro případné drobné použití,
% nikoli pro dekorativní prvky šablony.
\RequirePackage{xcolor}

% ifthen = jednoduché podmínky, například pro titulní stranu či volby.
\RequirePackage{ifthen}

% caption = jednotný vzhled popisků obrázků, tabulek a grafů.
% Používáme malé písmo a český styl popisků.
\RequirePackage[font={sf,small},labelsep=period]{caption}

% Umožňuje měnit vzhled číslování stránnek.
\RequirePackage{fancyhdr}


% ============================================================
% ZÁKLADNÍ TYPOGRAFIE
% ============================================================

% Řádkování 1,3 pro běžný text.
\setstretch{1.3}

% Bez odsazení prvního řádku odstavce; mezera mezi odstavci 12 pt.
% To odpovídá školnímu zadání a Word vzoru.
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}

% Mírné "povoleni" sazby pro lepší zalomení řádků.
%\sloppy
\emergencystretch=3em

% Česká typografická pravidla pro uvozovky.
\shorthandoff{"}


% ============================================================
% ČÍSLOVÁNÍ STRÁNEK
% ============================================================
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[R]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% Styl plain používá report/book pro stránky kapitol
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[R]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}

% ============================================================
% NADPISY – PŘESNĚJI PODLE WORD STYLŮ
% ============================================================

% Kapitola = hlavní nadpis (Word: Nadpis 1).
% Podle vzoru je bezpatkové písmo, tučné, cca 16 pt.
% Používáme small caps pro podobný vizuální efekt jako ve Word šabloně.
\titleformat{\chapter}[hang]
  {\sffamily\bfseries\scshape\fontsize{16pt}{20pt}\selectfont}
  {\thechapter}{1em}{}
\titlespacing*{\chapter}{0cm}{0pt}{6pt}
% Nečíslované kapitoly
\titleformat{name=\chapter,numberless}[hang]
  {\sffamily\bfseries\scshape\fontsize{16pt}{20pt}\selectfont}
  {}{0pt}{}
\titlespacing*{name=\chapter,numberless}{0pt}{0pt}{6pt}

% Sekce = podkapitola (Word: Nadpis 2).
% Bezpatkové písmo, tučné, cca 14 pt.
\titleformat{\section}[hang]
  {\sffamily\bfseries\fontsize{14pt}{16pt}\selectfont}
  {\thesection}{1em}{}
\titlespacing*{\section}{0cm}{0pt}{6pt}
\titleformat{name=\section,numberless}[hang]
  {\sffamily\bfseries\fontsize{14pt}{16pt}\selectfont}
  {}{0pt}{}
\titlespacing*{name=\section,numberless}{0pt}{0pt}{6pt}


% Podsekce = další úroveň členění (Word: Nadpis 3).
% Bezpatkové písmo, 14 pt, bez tučného řezu.
\titleformat{\subsection}[hang]
  {\sffamily\fontsize{14pt}{16pt}\selectfont}
  {\thesubsection}{1em}{}
\titlespacing*{\subsection}{0cm}{0pt}{6pt}

% Podpodsekce = méně výrazná, ale stále konzistentní s prací.
\titleformat{\subsubsection}[hang]
  {\sffamily\itshape\fontsize{14pt}{16pt}\selectfont}
  {\thesubsubsection}{1em}{}
\titlespacing*{\subsubsection}{0cm}{0pt}{6pt}

% Hloubka číslování a obsahu.
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{2}

% ============================================================
% OBSAH – ODSAZENÍ A VZHLED PODLE WORD ŠABLONY
% ============================================================

% Společné nastavení tečkovaného vodítka
\renewcommand{\cftchapleader}{\cftdotfill{\cftdotsep}}
\renewcommand{\cftsecleader}{\cftdotfill{\cftdotsep}}
\renewcommand{\cftsubsecleader}{\cftdotfill{\cftdotsep}}

% Kapitoly v obsahu
\setlength{\cftchapindent}{0pt}
\setlength{\cftchapnumwidth}{0.75cm}
\renewcommand{\cftchapfont}{\scshape}
\renewcommand{\cftchappagefont}{}

% Sekce v obsahu
\setlength{\cftsecindent}{0,5cm}
\setlength{\cftsecnumwidth}{1cm}

% Podsekce v obsahu
\setlength{\cftsubsecindent}{1cm}
\setlength{\cftsubsecnumwidth}{1.25cm}

% Mezera mezi položkami obsahu
\setlength{\cftbeforechapskip}{6pt}
\setlength{\cftbeforesecskip}{0pt}
\setlength{\cftbeforesubsecskip}{0pt}

% Obsah – nadpis jako ve Word šabloně
\renewcommand{\contentsname}{Obsah}
\renewcommand{\cfttoctitlefont}{\sffamily\bfseries\scshape\fontsize{16pt}{20pt}\selectfont}
\renewcommand{\cftaftertoctitle}{\hfill}
\setlength{\cftaftertoctitleskip}{12pt}


% ============================================================
% NÁZVY SEZNAMŮ A FLOATŮ
% ============================================================

% Nadpisy seznamů
\renewcommand{\cftloftitlefont}{\sffamily\bfseries\scshape\fontsize{16pt}{20pt}\selectfont}
\renewcommand{\cftlottitlefont}{\sffamily\bfseries\scshape\fontsize{16pt}{20pt}\selectfont}

\renewcommand{\listfigurename}{Seznam obrázků}
\renewcommand{\listtablename}{Seznam tabulek}
\renewcommand{\contentsname}{Obsah}
\renewcommand{\bibname}{Seznam použité literatury}

% Grafy jako vlastní float.
\DeclareFloatingEnvironment[
  fileext=grf,
  placement=htbp,
  name=Graf,
  listname={Seznam grafů}
]{graph}

% Číslování obrázků, tabulek a grafů v hlavní části: 1, 2, 3...
\renewcommand{\thefigure}{\arabic{figure}}
\renewcommand{\thetable}{\arabic{table}}
\renewcommand{\thegraph}{\arabic{graph}}

% Popisky – menší písmo a český styl.

% ============================================================
% CITACE A BIBLIOGRAFIE
% ============================================================

% Zdrojový soubor bibliografie.
% Můžete změnit název, ale pak je nutné změnit i zde.
\addbibresource{DMP_a_RP_sablona.bib}

% ============================================================
% PŘÍLOHY – ŘÍMSKÉ ČÍSLICE
% ============================================================

% Přepnutí do režimu příloh.
% - stránkování v římských číslicích
% - číslování kapitol na I, II, III...
% - obrázky, tabulky a grafy v přílohách budou číslovány také římsky
%   (např. Obrázek I.1, Tabulka II.1, Graf III.2)
\newcommand{\StartAppendices}{%
  \clearpage
  \pagenumbering{Roman}
  \appendix
  \addtocontents{toc}{\protect\setcounter{tocdepth}{-1}}
  \renewcommand{\chaptername}{Příloha}
  \renewcommand{\thechapter}{\Roman{chapter}}
  \renewcommand{\thefigure}{\Roman{chapter}.\arabic{figure}}
  \renewcommand{\thetable}{\Roman{chapter}.\arabic{table}}
  \renewcommand{\thegraph}{\Roman{chapter}.\arabic{graph}}
}

% ============================================================
% UŽIVATELSKÉ MAKRO PRO TITULNÍ STRANU
