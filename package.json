{
  "name": "bod",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "pnpm gen:api && turbo run build",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm deploy:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:dev": "docker compose -f deploy/compose.dev.yml up -d",
    "db:seed": "cd apps/api && pnpm db:seed",
    "api:dev": "pnpm --filter @bod/api dev",
    "api:openapi": "pnpm --filter @bod/api openapi",
    "gen:api": "pnpm api:openapi && pnpm gen:client",
    "web:dev": "pnpm --filter @bod/web dev",
    "gen:client": "openapi-ts",
    "deploy:check": "uv run ruff check deploy tests/deploy && uv run ruff format --check deploy tests/deploy && uv run python -m unittest discover -s tests/deploy -v"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@hey-api/openapi-ts": "^0.99.0",
    "turbo": "^2.10.7"
  },
  "pnpm": {
    "overrides": {
      "postcss@8": "^8.5.23",
      "undici@7": "^7.30.1",
      "js-yaml@4": "^4.3.2",
      "nanoid@3": "^3.3.18",
      "source-map-js@1": "^1.2.2"
    }
  }
}
