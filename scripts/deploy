#!/usr/bin/env bash
# Protected GitLab shell runner; application images are built by GitHub CI.
set -euo pipefail
umask 077
cd "$(dirname "$0")/.."
: "${CI_COMMIT_SHA:?Run in GitLab CI}"
: "${CI_REGISTRY_IMAGE:?Missing project registry}"
: "${CI_REGISTRY:?Missing registry host}"
: "${CI_JOB_TOKEN:?Missing registry credential}"
[[ "${CI_COMMIT_REF_PROTECTED:-}" == true && "${BOD_DEPLOY_SHA:-}" == "$CI_COMMIT_SHA" ]] || exit 1
root="${BOD_DEPLOY_DIR:-/home/student/bod-development}"
head=$(git ls-remote origin "refs/heads/$CI_COMMIT_REF_NAME" | cut -f1)
if [[ "$head" != "$CI_COMMIT_SHA" ]]; then
  echo 'Větev už obsahuje novější commit; tento deploy přeskakuji.'
  exit 0
fi
temporary=$(mktemp -d)
trap 'rm -rf "$temporary"' EXIT
export DOCKER_CONFIG="$temporary/docker"
mkdir -p "$DOCKER_CONFIG"
printf '%s' "$CI_JOB_TOKEN" | docker login "$CI_REGISTRY" --username gitlab-ci-token --password-stdin
for service in api web; do
  image="$CI_REGISTRY_IMAGE/$service:sha-$CI_COMMIT_SHA"
  docker pull "$image"
  digest=$(docker image inspect --format '{{index .RepoDigests 0}}' "$image")
  [[ "$digest" == "$CI_REGISTRY_IMAGE/$service@sha256:"* ]] || exit 1
  printf '%s_IMAGE=%s\n' "$(printf '%s' "$service" | tr '[:lower:]' '[:upper:]')" "$digest" >> "$temporary/images.env"
done
mkdir -p "$root"
install -m 755 deploy/bod.py "$root/bod.py"
install -m 644 deploy/compose.yml deploy/Caddyfile "$root/"
if [[ -f "$root/.initialized" ]]; then
  python3 "$root/bod.py" update "$temporary/images.env"
else
  install -m 600 "$temporary/images.env" "$root/images.env"
  python3 "$root/bod.py" install --domain "${BOD_DEPLOY_DOMAIN:-10.202.30.201}" > "$root/.first-admin.txt"
  echo 'Přihlašovací údaje správce jsou na VPS v .first-admin.txt.'
fi
