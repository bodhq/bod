#!/usr/bin/env bash
# Shared entry points for local runs, GitHub Actions and GitLab CI.
set -euo pipefail
cd "$(dirname "$0")/.."
pnpm() { corepack pnpm "$@"; }
export DATABASE_URL=sqlite:// DEBUG=false

case "${1:-check}" in
  docs)
    mkdir -p dist/docs
    docker run --rm --platform linux/amd64 --network none --user "$(id -u):$(id -g)" -e HOME=/tmp --entrypoint bash \
      -v "$PWD/docs:/work/docs:ro" -v "$PWD/scripts/docs:/work/scripts/docs:ro" \
      -v "$PWD/dist/docs:/work/dist/docs" -w /work \
      ghcr.io/xu-cheng/texlive-full:20260701@sha256:11383430b9a3e48c0b79339f34d8092f942f897d91ab3749d4899d06731fea7f \
      scripts/docs
    ;;
  install)
    pnpm install --frozen-lockfile
    uv sync --all-packages --all-groups --frozen
    ;;
  check)
    pnpm api:openapi
    git diff --exit-code -- apps/api/schema/openapi.json
    pnpm gen:client
    pnpm --filter @bod/e2e exec playwright install --with-deps chromium
    pnpm audit --audit-level=high
    pnpm check
    ;;
  integration)
    if [[ -z "${TEST_POSTGRES_URL:-}" && -z "${TEST_REDIS_URL:-}" ]]; then
      project="bod-integration-$$-$RANDOM"
      export POSTGRES_PORT=0 REDIS_PORT=0
      compose=(docker compose -p "$project" -f deploy/compose.dev.yml)
      trap '"${compose[@]}" down --volumes --remove-orphans' EXIT
      "${compose[@]}" up -d --wait
      postgres_port=$("${compose[@]}" port db 5432)
      redis_port=$("${compose[@]}" port redis 6379)
      export TEST_POSTGRES_URL="postgresql+psycopg://bod:bod@127.0.0.1:${postgres_port##*:}/bod"
      export TEST_REDIS_URL="redis://127.0.0.1:${redis_port##*:}/0"
    fi
    : "${TEST_POSTGRES_URL:?Set an isolated test database URL}"
    : "${TEST_REDIS_URL:?Set an isolated test Redis URL}"
    uv run pytest -m 'postgres or redis' --no-cov
    ;;
  production)
    docker build -f apps/api/Dockerfile -t bod-ci-api:verify .
    docker build -f apps/web/Dockerfile -t bod-ci-web:verify .
    uv run python tests/deploy/smoke.py
    ;;
  publish)
    : "${GITLAB_TOKEN:?Set the GitLab project access token}"
    : "${GITHUB_SHA:?Missing commit SHA}"
    : "${GITHUB_REF_NAME:?Missing branch}"
    [[ "$GITHUB_SHA" =~ ^[0-9a-f]{40}$ ]] || exit 1
    head=$(git ls-remote origin "refs/heads/$GITHUB_REF_NAME" | cut -f1)
    if [[ "$head" != "$GITHUB_SHA" ]]; then
      echo 'Novější commit už čeká na sestavení; tuto verzi nenasazuji.'
      exit 0
    fi
    project='studentske-projekty/projekty-2026-2027/mtp1/navrh-a-implementace-modularniho-skolniho-informacniho-systemu'
    api="https://gitlab.spseplzen.cz/api/v4"
    endpoint="$api/projects/${project//\//%2F}"
    temporary=$(mktemp -d)
    trap 'rm -rf "$temporary"' EXIT
    export DOCKER_CONFIG="$temporary/docker"
    mkdir -p "$DOCKER_CONFIG"
    printf 'header = "PRIVATE-TOKEN: %s"\n' "$GITLAB_TOKEN" > "$temporary/auth"
    chmod 600 "$temporary/auth"
    metadata=$(curl --fail --silent --show-error --connect-timeout 10 --max-time 30 --config "$temporary/auth" "$endpoint")
    registry=$(jq -er '.container_registry_image_prefix | select(type == "string" and length > 0)' <<< "$metadata")
    username=$(curl --fail --silent --show-error --connect-timeout 10 --max-time 30 --config "$temporary/auth" "$api/user" | jq -er .username)
    printf '%s' "$GITLAB_TOKEN" | docker login "${registry%%/*}" --username "$username" --password-stdin
    for service in api web; do
      image="$registry/$service:sha-$GITHUB_SHA"
      docker tag "bod-ci-$service:verify" "$image"
      docker push "$image"
    done
    # Synchronize this exact commit before triggering the protected deploy job.
    git push "https://oauth2:${GITLAB_TOKEN}@gitlab.spseplzen.cz/$project.git" "HEAD:refs/heads/$GITHUB_REF_NAME"
    payload=$(jq -n --arg ref "$GITHUB_REF_NAME" --arg sha "$GITHUB_SHA" \
      '{ref: $ref, variables: [{key: "BOD_DEPLOY_SHA", value: $sha}]}')
    curl --fail --silent --show-error --connect-timeout 10 --max-time 30 \
      --config "$temporary/auth" --header 'Content-Type: application/json' \
      --request POST --data "$payload" "$endpoint/pipeline" | jq -er .web_url
    ;;
  release)
    : "${BOD_TAG:?Set the version tag, for example v0.1.0}"
    [[ "$BOD_TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo 'Invalid release tag' >&2; exit 1; }
    : "${BOD_REGISTRY:=ghcr.io/bodhq/bod}"
    rm -rf dist/deploy
    mkdir -p dist/deploy
    anonymous=$(mktemp -d)
    trap 'rm -rf "$anonymous"' EXIT
    for service in api web; do
      image="$BOD_REGISTRY/$service:${BOD_TAG#v}"
      docker tag "bod-ci-$service:verify" "$image"
      docker push "$image"
      digest=$(docker image inspect --format '{{index .RepoDigests 0}}' "$image")
      [[ "$digest" == "$BOD_REGISTRY/$service@sha256:"* ]] || exit 1
      printf '%s_IMAGE=%s\n' "$(printf '%s' "$service" | tr '[:lower:]' '[:upper:]')" "$digest" >> dist/deploy/images.env
    done
    while IFS='=' read -r _ image; do
      docker --config "$anonymous" manifest inspect "$image" > /dev/null || {
        echo "Obraz $image není anonymně dostupný. Zkontroluj veřejnou viditelnost balíčku v GHCR a opakuj job." >&2
        exit 1
      }
    done < dist/deploy/images.env
    cp deploy/bod.py deploy/compose.yml deploy/Caddyfile dist/deploy/
    tar -czf "dist/bod-$BOD_TAG.tar.gz" -C dist deploy
    (cd dist && sha256sum "bod-$BOD_TAG.tar.gz" > "bod-$BOD_TAG.sha256")
    ;;
  *) echo 'Usage: scripts/ci {install|check|integration|production|publish|release|docs}' >&2; exit 2 ;;
esac
