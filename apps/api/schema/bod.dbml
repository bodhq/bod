// Cílový návrh, nikoli migrace aktuální databáze.
// Poznámky popisují i pravidla vyžadující SQL migraci či službu.
// Publikace, suplování a změny členství musí v jedné transakci
// se zámkem ověřit kolize i všechna pravidla napříč tabulkami.
// EXCLUDE constraints v SQL migraci: překryvy zařazení žáka,
// členství stejné skupiny, časových slotů a publikovaných verzí.
// Triggery/služby: stejné školní roky a plány, zmrazení historie,
// úplný kalendář a úvazky, role a objektová oprávnění.
// updated_at se nastavuje při každé změně službou nebo triggerem.

Project bod {
  database_type: 'PostgreSQL'
  Note: 'Jedna škola. Core a moduly jsou vizuálně oddělené pomocí TableGroup. Cílový model. Datumové i časové intervaly používají [od, do); NULL konec znamená neomezený interval. Školní data a zvonění se vyhodnocují v Europe/Prague; skutečné okamžiky jsou timestamptz.'
}

// ENUMY

Enum group_membership_mode {
  class_enrollment
  explicit
}

Enum group_division_method {
  alphabetical
  specialization
  manual
}

Enum membership_origin {
  generated
  manual
}

Enum timetable_status {
  draft
  published
  archived
}

Enum lesson_change_type {
  modified
  cancelled
}

Enum audit_operation {
  created
  updated
  deleted
}

Enum classbook_entry_status {
  draft
  signed
}

Enum attendance_status {
  present
  absent
  late
  released_early
}

Enum excuse_request_status {
  open
  closed
  withdrawn
}

Enum excuse_item_decision {
  pending
  approved
  rejected
}

// ========================================
// CORE: ÚČTY A OPRÁVNĚNÍ
// ========================================

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  username varchar(64) [not null, unique]
  hashed_password text [not null]
  is_active boolean [not null, default: true]
  must_change_password boolean [not null, default: true]
  avatar_url varchar(512)

  first_name varchar(100)
  last_name varchar(100)
  display_name varchar(100)
  email varchar(254)
  phone varchar(32)

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `username = lower(btrim(username)) AND length(username) BETWEEN 3 AND 64` [name: 'users_username_nonempty']
  }

  Note: 'Profil může být neúplný. Username se při zápisu normalizuje. Admin používá samostatný účet. Účty s historickými vazbami se deaktivují.'
}

Table roles {
  code varchar(64) [pk]
  name varchar(100) [not null]
  description text

  Note: 'Například student, parent, teacher, admin. Zákaz kombinace admina s běžnými rolemi hlídá služba nebo trigger.'
}

Table permissions {
  code varchar(100) [pk]
  description text [not null]

  Note: 'Například profile.self.update, users.manage, roles.manage, timetable.read, timetable.edit, timetable.generate, timetable.publish, timetable.substitute, classbook.write, classbook.correct, attendance.mark, attendance.excuse.'
}

Table user_roles {
  user_id uuid [not null]
  role_code varchar(64) [not null]

  indexes {
    (user_id, role_code) [pk]
    role_code
  }
}

Table role_permissions {
  role_code varchar(64) [not null]
  permission_code varchar(100) [not null]

  indexes {
    (role_code, permission_code) [pk]
    permission_code
  }
}

Table auth_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  token_hash varchar(64) [not null, unique]

  active_role_code varchar(64)

  ip_address varchar(45)
  user_agent varchar(512)

  created_at timestamptz [not null, default: `now()`]
  last_seen_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]

  indexes {
    user_id
    expires_at
  }

  checks {
    `expires_at > created_at` [name: 'auth_sessions_expiry_valid']
  }

  Note: 'Oprávnění se vyhodnocují pouze z aktivní role. Před odebráním role se její aktivní výběr v relacích vyčistí.'
}

// ========================================
// CORE: AUDIT
// ========================================

Table audit_events {
  id uuid [pk, default: `gen_random_uuid()`]

  actor_user_id uuid
  actor_role_code varchar(64)

  operation audit_operation [not null]
  event_code varchar(100) [not null]

  entity_type varchar(100) [not null]
  entity_id varchar(255)

  before_data jsonb
  after_data jsonb

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (entity_type, entity_id, created_at)
    (actor_user_id, created_at)
  }

  Note: 'Neměnný audit v transakci se změnou. actor_role_code je historický snímek bez FK. entity_id podporuje UUID i textové klíče rolí a oprávnění. Systémové operace mohou mít actor_user_id NULL. Citlivé autentizační údaje se do auditu nekopírují.'
}

// ========================================
// MODUL SCHOOL: EVIDENCE
// ========================================

Table school_years {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(20) [not null, unique]

  starts_on date [not null]
  ends_on date [not null]

  checks {
    `starts_on < ends_on` [name: 'school_years_interval_valid']
  }

  Note: 'ends_on je první den mimo školní rok.'
}

Table specializations {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(30) [not null, unique]
  name varchar(100) [not null]
  is_active boolean [not null, default: true]
}

Table classes {
  id uuid [pk, default: `gen_random_uuid()`]
  school_year_id uuid [not null]
  name varchar(30) [not null]
  class_teacher_id uuid

  indexes {
    (school_year_id, name) [unique]
  }

  Note: 'Evidenční třída pro jeden školní rok.'
}

Table class_enrollments {
  id uuid [pk, default: `gen_random_uuid()`]
  student_id uuid [not null]
  class_id uuid [not null]
  specialization_id uuid

  valid_from date [not null]
  valid_to date

  indexes {
    (student_id, class_id, valid_from) [unique]
    (class_id, valid_from)
  }

  checks {
    `valid_to IS NULL OR valid_from < valid_to` [name: 'class_enrollments_interval_valid']
  }

  Note: 'Změna třídy nebo zaměření založí nový interval. Souběžné zařazení žáka do více evidenčních tříd ve stejném školním roce se nepovoluje.'
}

Table parent_students {
  parent_id uuid [not null]
  student_id uuid [not null]

  indexes {
    (parent_id, student_id) [pk]
    student_id
  }

  checks {
    `parent_id <> student_id` [name: 'parent_students_distinct_users']
  }
}

Table subjects {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(20) [not null, unique]
  name varchar(100) [not null]
}

// ========================================
// MODUL SCHOOL: SKUPINY
// ========================================

Table group_divisions {
  id uuid [pk, default: `gen_random_uuid()`]
  class_id uuid [not null]
  name varchar(100) [not null]
  method group_division_method [not null]
  effective_from date [not null]

  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (class_id, name) [unique]
  }

  Note: 'Generování vytvoří uložené členství. Pozdější přepočet vyžaduje potvrzení a nové intervaly; změna jména automaticky nerozděluje žáky znovu.'
}

Table teaching_groups {
  id uuid [pk, default: `gen_random_uuid()`]
  school_year_id uuid [not null]
  name varchar(100) [not null]
  description text

  membership_mode group_membership_mode [not null]

  source_class_id uuid [unique]

  division_id uuid
  position integer

  indexes {
    (school_year_id, name) [unique]
    (division_id, position) [unique]
  }

  checks {
    `(membership_mode = 'class_enrollment' AND source_class_id IS NOT NULL AND division_id IS NULL) OR (membership_mode = 'explicit' AND source_class_id IS NULL)` [name: 'teaching_groups_membership_source_valid']

    `(division_id IS NULL AND position IS NULL) OR (division_id IS NOT NULL AND position IS NOT NULL AND position > 0)` [name: 'teaching_groups_division_position_valid']
  }

  Note: 'Celá třída odvozuje členství z class_enrollments. Explicitní skupina používá teaching_group_memberships. Zdrojová třída a rozdělení musejí patřit do stejného školního roku jako skupina.'
}

Table teaching_group_memberships {
  id uuid [pk, default: `gen_random_uuid()`]
  group_id uuid [not null]
  student_id uuid [not null]

  valid_from date [not null]
  valid_to date

  origin membership_origin [not null]
  created_by uuid
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (group_id, student_id, valid_from) [unique]
    (student_id, valid_from)
  }

  checks {
    `valid_to IS NULL OR valid_from < valid_to` [name: 'group_memberships_interval_valid']
  }

  Note: 'Pouze pro explicitní skupiny. Překryv členství stejného žáka ve stejné skupině se zakazuje. V jednom dělení může být žák současně nejvýše v jedné výsledné skupině.'
}

Table group_specialization_rules {
  group_id uuid [not null]
  specialization_id uuid [not null]

  indexes {
    (group_id, specialization_id) [pk]
  }

  Note: 'Pouze pro rozdělení podle zaměření. Jedno zaměření nesmí v jednom rozdělení směrovat do více skupin.'
}

// ========================================
// MODUL FACILITIES: MÍSTNOSTI
// ========================================

Table room_types {
  code varchar(50) [pk]
  name varchar(100) [not null]
}

Table rooms {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(30) [not null, unique]
  name varchar(100)

  room_type_code varchar(50) [not null]
  capacity integer [not null]
  is_active boolean [not null, default: true]

  indexes {
    (room_type_code, capacity)
  }

  checks {
    `capacity > 0` [name: 'rooms_capacity_positive']
  }
}

Table group_home_rooms {
  group_id uuid [pk]
  room_id uuid [not null]

  indexes {
    room_id
  }

  Note: 'Nepovinná kmenová učebna. Bez přiřazení neexistuje řádek. Je to preference, nikoli rezervace. Podskupina ji automaticky nedědí.'
}

// ========================================
// MODUL FACILITIES: RELATIVNÍ VZDÁLENOSTI
// ========================================

Table room_distance_models {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null]
  description text

  created_at timestamptz [not null, default: `now()`]
  frozen_at timestamptz

  Note: 'Při prvním publikování navázaného rozvrhu se model zmrazí. Matice nejkratších cest je odvozená cache; úprava nezmrazeného grafu ji musí zneplatnit.'
}

Table room_connections {
  distance_model_id uuid [not null]
  from_room_id uuid [not null]
  to_room_id uuid [not null]

  relative_cost decimal(10, 3) [not null]

  indexes {
    (distance_model_id, from_room_id, to_room_id) [pk]
  }

  checks {
    `from_room_id <> to_room_id` [name: 'room_connections_no_self_edge']
    `relative_cost > 0` [name: 'room_connections_cost_positive']
  }

  Note: 'Orientované spojnice s relativní cenou. Obousměrný průchod má oba směry. Cena přesunu do stejné místnosti je odvozená nula. Nedosažitelná cesta má nekonečnou cenu.'
}

Table room_unavailability {
  id uuid [pk, default: `gen_random_uuid()`]
  room_id uuid [not null]

  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  reason text

  indexes {
    (room_id, starts_at)
  }

  checks {
    `starts_at < ends_at` [name: 'room_unavailability_interval_valid']
  }
}

// ========================================
// MODUL TIMETABLE: VERZOVANÉ ZADÁNÍ VÝUKY
// ========================================

Table teaching_plans {
  id uuid [pk, default: `gen_random_uuid()`]
  school_year_id uuid [not null]
  name varchar(150) [not null]
  cycle_anchor_monday date [not null]

  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  frozen_at timestamptz

  indexes {
    (school_year_id, name) [unique]
  }

  checks {
    `extract(isodow FROM cycle_anchor_monday) = 1` [name: 'teaching_plans_cycle_anchor_monday']
  }

  Note: 'Verze zadání výuky sdílená variantami rozvrhu. cycle_anchor_monday je začátek prvního kroku vlastního cyklu; může předcházet školnímu roku. Po prvním publikování se zmrazí včetně kroků cyklu, typů týdnů, kalendáře, zadání a bloků. Další změny vyžadují nový plán, který může zachovat původní kotvu a fázi cyklu.'
}

Table teaching_assignments {
  id uuid [pk, default: `gen_random_uuid()`]
  teaching_plan_id uuid [not null]

  group_id uuid [not null]
  subject_id uuid [not null]
  teacher_id uuid [not null]

  required_room_type_code varchar(50)

  indexes {
    (teaching_plan_id, group_id, subject_id, teacher_id) [unique]
    group_id
    teacher_id
  }

  Note: 'Skupina musí patřit do školního roku plánu. Rozsah výuky je v teaching_assignment_weeks zvlášť pro každý typ týdne. Chybějící řádek znamená bez výuky. Zmrazená zadání se nepřepisují.'
}

Table teaching_cycle_weeks {
  id uuid [pk, default: `gen_random_uuid()`]
  teaching_plan_id uuid [not null]
  position smallint [not null]
  code varchar(20) [not null]
  name varchar(100)
  indexes {
    (teaching_plan_id, position) [unique]
    (teaching_plan_id, code) [unique]
    (teaching_plan_id, id) [unique]
  }
  checks {
    `position > 0` [name: 'cycle_weeks_position_positive']
  }
  Note: 'Uživatelské typy týdnů s vlastním kódem a názvem. position určuje pouze pořadí zobrazení; frekvenci a posloupnost určují teaching_cycle_steps. Stejný typ lze použít ve více krocích. Zmrazí se s plánem.'
}

Table teaching_cycle_steps {
  id uuid [pk, default: `gen_random_uuid()`]
  teaching_plan_id uuid [not null]
  position integer [not null]
  cycle_week_id uuid [not null]
  duration_weeks integer [not null, default: 1]

  indexes {
    (teaching_plan_id, position) [unique]
    (teaching_plan_id, cycle_week_id)
  }

  checks {
    `position > 0` [name: 'cycle_steps_position_positive']
    `duration_weeks > 0` [name: 'cycle_steps_duration_positive']
  }

  Note: 'Vlastní opakující se posloupnost. Kroky jsou souvisle očíslované od 1; plán má při publikaci alespoň jeden krok. Délka celého cyklu je součet duration_weeks a neukládá se duplicitně. Příklad A na 2 týdny a B na 1 týden vytváří A,A,B,A,A,B. Povolena je i posloupnost A,B,A,C. Jeden krok na 1 týden znamená stejný rozvrh každý týden. Kroky se zmrazí s plánem.'
}

Table teaching_plan_calendar_weeks {
  teaching_plan_id uuid [not null]
  week_starts_on date [not null]
  cycle_week_id uuid [not null]
  is_override boolean [not null, default: false]
  indexes {
    (teaching_plan_id, week_starts_on) [pk]
    cycle_week_id
  }
  checks {
    `extract(isodow FROM week_starts_on) = 1` [name: 'calendar_weeks_start_monday']
  }
  Note: 'Výsledné mapování: jeden řádek pro každé pondělí týdne zasahujícího do školního roku. Služba vypočte celé týdny od cycle_anchor_monday a nezáporné modulo délkou cyklu; krok najde podle kumulativních délek. is_override=true dovoluje ručně zvolený typ pouze pro tento týden a neposouvá další kroky. Změna kroků nebo kotvy v návrhu přegeneruje řádky bez override; ruční výjimky zachová. Prázdniny cyklus neposouvají. Při publikaci je povinné úplné pokrytí a shoda automatických řádků s cyklem. Zmrazí se s plánem.'
}

Table teaching_plan_calendar_days {
  teaching_plan_id uuid [not null]
  calendar_date date [not null]
  is_teaching_day boolean [not null]
  reason text
  indexes {
    (teaching_plan_id, calendar_date) [pk]
  }
  Note: 'Výjimky z pravidla pondělí až pátek: svátky, prázdniny, ředitelské volno nebo výuková sobota. Datum musí být uvnitř školního roku. Výjimka nemění typ týdne. Zmrazí se s plánem; pozdější rušení konkrétních hodin se řeší lesson_changes.'
}

Table teaching_assignment_weeks {
  teaching_assignment_id uuid [not null]
  cycle_week_id uuid [not null]
  periods integer [not null]
  indexes {
    (teaching_assignment_id, cycle_week_id) [pk]
    cycle_week_id
  }
  checks {
    `periods > 0` [name: 'assignment_weeks_periods_positive']
  }
  Note: 'Počet vyučovacích slotů daného zadání v jednom týdnu tohoto typu. Zadání a typ týdne musí mít stejný plán. Při publikaci počet položek rozvrhu pro každou dvojici přesně odpovídá periods. Například fyzika pouze A, chemie pouze B; běžná matematika má řádek pro A i B.'
}

Table teaching_blocks {
  id uuid [pk, default: `gen_random_uuid()`]
  cycle_week_id uuid [not null]
  name varchar(100) [not null]

  indexes {
    (cycle_week_id, name) [unique]
    (id, cycle_week_id) [unique]
  }

  Note: 'Blok platí pro jediný typ týdne. Synchronizuje společné termíny výuk. Členové musejí patřit do stejného plánu a mít v tomto typu týdne stejné počty hodin bez společných žáků a učitelů. Členové mají totožnou množinu termínů (den, slot).'
}

Table teaching_block_members {
  block_id uuid [not null]
  teaching_assignment_id uuid [not null]
  cycle_week_id uuid [not null]

  indexes {
    (block_id, teaching_assignment_id) [pk]
    (teaching_assignment_id, cycle_week_id) [unique]
  }
}

Table teacher_unavailability {
  id uuid [pk, default: `gen_random_uuid()`]
  teacher_id uuid [not null]

  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  reason text

  indexes {
    (teacher_id, starts_at)
  }

  checks {
    `starts_at < ends_at` [name: 'teacher_unavailability_interval_valid']
  }
}

// ========================================
// MODUL TIMETABLE: ČASY A VARIANTY
// ========================================

Table time_grids {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null]
  description text
  frozen_at timestamptz

  Note: 'Po prvním publikování se sada i její sloty zmrazí. Jiné zvonění vyžaduje novou sadu.'
}

Table time_slots {
  id uuid [pk, default: `gen_random_uuid()`]
  time_grid_id uuid [not null]

  position integer [not null]
  start_time time [not null]
  end_time time [not null]

  indexes {
    (time_grid_id, position) [unique]
  }

  checks {
    `position > 0` [name: 'time_slots_position_positive']
    `start_time < end_time` [name: 'time_slots_interval_valid']
  }

  Note: 'Sloty jedné sady se nesmějí časově překrývat.'
}

Table timetable_versions {
  id uuid [pk, default: `gen_random_uuid()`]
  teaching_plan_id uuid [not null]
  time_grid_id uuid [not null]
  distance_model_id uuid [not null]

  name varchar(150) [not null]
  status timetable_status [not null, default: 'draft']
  based_on_version_id uuid

  valid_from date
  valid_to date

  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  published_at timestamptz

  indexes {
    (teaching_plan_id, status)
    (status, valid_from)
  }

  checks {
    `valid_to IS NULL OR (valid_from IS NOT NULL AND valid_from < valid_to)` [name: 'timetable_versions_interval_valid']

    `status = 'draft' OR (valid_from IS NOT NULL AND published_at IS NOT NULL)` [name: 'timetable_versions_publication_required']

    `based_on_version_id IS NULL OR based_on_version_id <> id` [name: 'timetable_versions_no_self_base']
  }

  Note: 'Školní rok se odvozuje z teaching_plans. published a archived představují publikovanou historii, jejíž intervaly se nesmějí překrývat. Obsah publikované verze je neměnný; řízené ukončení její platnosti se audituje.'
}

Table timetable_entries {
  id uuid [pk, default: `gen_random_uuid()`]
  timetable_version_id uuid [not null]
  teaching_assignment_id uuid [not null]

  cycle_week_id uuid [not null]
  day_of_week smallint [not null]
  time_slot_id uuid [not null]
  room_id uuid

  is_locked boolean [not null, default: false]

  indexes {
    (timetable_version_id, cycle_week_id, day_of_week, time_slot_id)
    (timetable_version_id, cycle_week_id, room_id, day_of_week, time_slot_id)
    (timetable_version_id, teaching_assignment_id, cycle_week_id, day_of_week, time_slot_id) [unique]
    teaching_assignment_id
  }

  checks {
    `day_of_week BETWEEN 1 AND 7` [name: 'timetable_entries_weekday_valid']
  }

  Note: 'Jedna pravidelná hodina v daném typu týdne. Zadání a typ týdne musí patřit do plánu verze, slot do její sady časů. Kolize učitele, místnosti i společných žáků se kontrolují uvnitř stejného typu týdne. Členství žáků i datumové nedostupnosti se prověří pro konkrétní kalendářní data. Uzamčené položky generátor nepřesouvá.'
}

Table timetable_preferences {
  id uuid [pk, default: `gen_random_uuid()`]
  timetable_version_id uuid [not null]

  code varchar(100) [not null]
  weight integer [not null]
  parameters jsonb

  indexes {
    (timetable_version_id, code) [unique]
  }

  checks {
    `weight >= 0` [name: 'timetable_preferences_weight_nonnegative']
  }

  Note: 'Váhy podporovaných preferencí. Nula vypíná penalizaci. Například minimalizace oken, relativních přesunů nebo preference kmenové učebny. Nejde o povinná pravidla.'
}

// ========================================
// MODUL TIMETABLE: KONKRÉTNÍ HODINY A SUPLOVÁNÍ
// ========================================

Table lesson_occurrences {
  id uuid [pk, default: `gen_random_uuid()`]
  timetable_entry_id uuid [not null]
  scheduled_date date [not null]

  indexes {
    (timetable_entry_id, scheduled_date) [unique]
    scheduled_date
  }

  Note: 'Konkrétní hodina z publikované historie. Datum musí odpovídat dni, typu týdne podle teaching_plan_calendar_weeks, výukovému dni kalendáře a platnosti původní verze i školního roku. Přesun nemění scheduled_date. Změna mapování nebo nová verze nesmí přepsat existující historické hodiny.'
}

Table lesson_changes {
  id uuid [pk, default: `gen_random_uuid()`]
  lesson_occurrence_id uuid [not null, unique]
  change_type lesson_change_type [not null]

  replacement_teacher_id uuid

  room_changed boolean [not null, default: false]
  replacement_room_id uuid

  replacement_date date
  replacement_time_slot_id uuid

  note text

  created_by uuid [not null]
  updated_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `room_changed OR replacement_room_id IS NULL` [name: 'lesson_changes_room_override_valid']

    `change_type <> 'cancelled' OR (replacement_teacher_id IS NULL AND NOT room_changed AND replacement_room_id IS NULL AND replacement_date IS NULL AND replacement_time_slot_id IS NULL)` [name: 'lesson_changes_cancellation_valid']

    `change_type <> 'modified' OR (replacement_teacher_id IS NOT NULL OR room_changed OR replacement_date IS NOT NULL OR replacement_time_slot_id IS NOT NULL)` [name: 'lesson_changes_modification_nonempty']
  }

  Note: 'Jeden aktuální záznam na hodinu. NULL náhradního učitele, data nebo slotu ponechává původní hodnotu. room_changed=true s NULL místností ji vymaže. Smazání změny obnoví původní plán. Každá změna se audituje. Náhradní slot musí patřit do sady časů původní verze. Kolize se kontrolují podle výsledného data a času napříč všemi platnými verzemi, včetně jiných přesunutých hodin. Ruší se i výuka pořízená před zjištěním dne volna.'
}

// ========================================
// MODUL CLASSBOOK: SKUTEČNÁ VÝUKA
// ========================================

Table classbook_entries {
  id uuid [pk, default: `gen_random_uuid()`]
  lesson_occurrence_id uuid [unique]

  group_id uuid [not null]
  subject_id uuid [not null]
  actual_teacher_id uuid [not null]
  actual_room_id uuid

  starts_at timestamptz [not null]
  ends_at timestamptz [not null]

  topic text
  note text

  status classbook_entry_status [not null, default: 'draft']
  signed_by uuid
  signed_at timestamptz

  created_by uuid [not null]
  updated_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (group_id, starts_at)
    (actual_teacher_id, starts_at)
    starts_at
  }

  checks {
    `starts_at < ends_at` [name: 'classbook_entries_interval_valid']

    `(status = 'draft' AND signed_by IS NULL AND signed_at IS NULL) OR (status = 'signed' AND signed_by IS NOT NULL AND signed_at IS NOT NULL AND topic IS NOT NULL AND length(btrim(topic)) > 0)` [name: 'classbook_entries_signature_valid']
  }

  Note: 'Historický snímek skutečné výuky včetně suplování. NULL occurrence umožňuje mimořádnou výuku. Pozdější změny plánu údaje nepřepisují. Oprava podepsaného zápisu vyžaduje zvláštní oprávnění a audit.'
}

Table classbook_participants {
  classbook_entry_id uuid [not null]
  student_id uuid [not null]
  indexes {
    (classbook_entry_id, student_id) [pk]
    student_id
  }
  Note: 'Uložený historický seznam žáků hodiny. Při založení se naplní z členství platného v den skutečné výuky. Pozdější změna členství jej nepřepíše. U podepsaného zápisu vyžaduje oprava zvláštní oprávnění a audit. Chybějící attendance_record znamená nezaznamenanou docházku.'
}

Table attendance_records {
  id uuid [pk, default: `gen_random_uuid()`]
  classbook_entry_id uuid [not null]
  student_id uuid [not null]

  status attendance_status [not null]
  late_minutes integer
  missed_minutes integer

  is_excused boolean [not null, default: false]
  excuse_reason text
  excused_by uuid
  excused_at timestamptz

  note text

  recorded_by uuid [not null]
  recorded_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (classbook_entry_id, student_id) [unique]
    student_id
  }

  checks {
    `late_minutes IS NULL OR late_minutes >= 0` [name: 'attendance_late_minutes_nonnegative']

    `missed_minutes IS NULL OR missed_minutes >= 0` [name: 'attendance_missed_minutes_nonnegative']

    `status <> 'late' OR (late_minutes IS NOT NULL AND late_minutes > 0)` [name: 'attendance_late_status_valid']

    `status = 'late' OR COALESCE(late_minutes, 0) = 0` [name: 'attendance_nonlate_minutes_valid']

    `status <> 'present' OR COALESCE(missed_minutes, 0) = 0` [name: 'attendance_present_minutes_valid']

    `(is_excused AND status <> 'present' AND excused_by IS NOT NULL AND excused_at IS NOT NULL) OR (NOT is_excused AND excused_by IS NULL AND excused_at IS NULL)` [name: 'attendance_excuse_valid']
  }

  Note: 'Docházka potvrzená učitelem, nikoli automatická výchozí přítomnost. Žák musí být v classbook_participants. Historický seznam se ukládá, nikoli znovu odvozuje při čtení. Minuty nesmějí přesahovat délku výuky.'
}

Table absence_excuse_requests {
  id uuid [pk, default: `gen_random_uuid()`]
  student_id uuid [not null]
  requested_by uuid [not null]

  reason text [not null]
  status excuse_request_status [not null, default: 'open']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  closed_at timestamptz

  indexes {
    (student_id, created_at)
    status
  }

  checks {
    `length(btrim(reason)) > 0` [name: 'excuse_requests_reason_nonempty']

    `(status = 'open' AND closed_at IS NULL) OR (status <> 'open' AND closed_at IS NOT NULL)` [name: 'excuse_requests_closure_valid']
  }

  Note: 'Žádost pro již evidované absence. Žadatel musí mít přístup k danému žákovi. Částečné schválení se odvozuje z rozhodnutí položek.'
}

Table absence_excuse_items {
  request_id uuid [not null]
  attendance_record_id uuid [not null]

  decision excuse_item_decision [not null, default: 'pending']
  decision_note text
  decided_by uuid
  decided_at timestamptz

  indexes {
    (request_id, attendance_record_id) [pk]
    attendance_record_id
  }

  checks {
    `(decision = 'pending' AND decided_by IS NULL AND decided_at IS NULL) OR (decision <> 'pending' AND decided_by IS NOT NULL AND decided_at IS NOT NULL)` [name: 'excuse_items_decision_valid']
  }

  Note: 'Absence musí patřit žákovi žádosti. Rozhodnutí, skutečný stav omluvení v attendance_records a audit se mění v jedné transakci. Služba řeší také opakované a souběžné žádosti.'
}

// ========================================
// VZTAHY: CORE
// ========================================

Ref: user_roles.user_id > users.id [delete: cascade]
Ref: user_roles.role_code > roles.code

Ref: role_permissions.role_code > roles.code [delete: cascade]
Ref: role_permissions.permission_code > permissions.code [delete: cascade]

Ref: auth_sessions.user_id > users.id [delete: cascade]
Ref: auth_sessions.(user_id, active_role_code) > user_roles.(user_id, role_code)

Ref: audit_events.actor_user_id > users.id [delete: set null]

// ========================================
// VZTAHY: SCHOOL
// ========================================

Ref: classes.school_year_id > school_years.id
Ref: classes.class_teacher_id > users.id

Ref: class_enrollments.student_id > users.id
Ref: class_enrollments.class_id > classes.id
Ref: class_enrollments.specialization_id > specializations.id

Ref: parent_students.parent_id > users.id
Ref: parent_students.student_id > users.id

Ref: group_divisions.class_id > classes.id
Ref: group_divisions.created_by > users.id

Ref: teaching_groups.school_year_id > school_years.id
Ref: teaching_groups.source_class_id > classes.id
Ref: teaching_groups.division_id > group_divisions.id

Ref: teaching_group_memberships.group_id > teaching_groups.id
Ref: teaching_group_memberships.student_id > users.id
Ref: teaching_group_memberships.created_by > users.id

Ref: group_specialization_rules.group_id > teaching_groups.id
Ref: group_specialization_rules.specialization_id > specializations.id

// ========================================
// VZTAHY: FACILITIES
// ========================================

Ref: rooms.room_type_code > room_types.code

Ref: group_home_rooms.group_id > teaching_groups.id [delete: cascade]
Ref: group_home_rooms.room_id > rooms.id

Ref: room_connections.distance_model_id > room_distance_models.id
Ref: room_connections.from_room_id > rooms.id
Ref: room_connections.to_room_id > rooms.id

Ref: room_unavailability.room_id > rooms.id

// ========================================
// VZTAHY: TIMETABLE
// ========================================

Ref: teaching_plans.school_year_id > school_years.id
Ref: teaching_plans.created_by > users.id

Ref: teaching_assignments.teaching_plan_id > teaching_plans.id
Ref: teaching_assignments.group_id > teaching_groups.id
Ref: teaching_assignments.subject_id > subjects.id
Ref: teaching_assignments.teacher_id > users.id
Ref: teaching_assignments.required_room_type_code > room_types.code

Ref: teaching_cycle_weeks.teaching_plan_id > teaching_plans.id
Ref: teaching_cycle_steps.teaching_plan_id > teaching_plans.id
Ref: teaching_cycle_steps.(teaching_plan_id, cycle_week_id) > teaching_cycle_weeks.(teaching_plan_id, id)
Ref: teaching_plan_calendar_weeks.teaching_plan_id > teaching_plans.id
Ref: teaching_plan_calendar_weeks.(teaching_plan_id, cycle_week_id) > teaching_cycle_weeks.(teaching_plan_id, id)
Ref: teaching_plan_calendar_days.teaching_plan_id > teaching_plans.id
Ref: teaching_assignment_weeks.teaching_assignment_id > teaching_assignments.id
Ref: teaching_assignment_weeks.cycle_week_id > teaching_cycle_weeks.id
Ref: teaching_blocks.cycle_week_id > teaching_cycle_weeks.id
Ref: teaching_block_members.(block_id, cycle_week_id) > teaching_blocks.(id, cycle_week_id) [delete: cascade]
Ref: teaching_block_members.(teaching_assignment_id, cycle_week_id) > teaching_assignment_weeks.(teaching_assignment_id, cycle_week_id)

Ref: teacher_unavailability.teacher_id > users.id

Ref: time_slots.time_grid_id > time_grids.id

Ref: timetable_versions.teaching_plan_id > teaching_plans.id
Ref: timetable_versions.time_grid_id > time_grids.id
Ref: timetable_versions.distance_model_id > room_distance_models.id
Ref: timetable_versions.based_on_version_id > timetable_versions.id
Ref: timetable_versions.created_by > users.id

Ref: timetable_entries.timetable_version_id > timetable_versions.id
Ref: timetable_entries.(teaching_assignment_id, cycle_week_id) > teaching_assignment_weeks.(teaching_assignment_id, cycle_week_id)
Ref: timetable_entries.time_slot_id > time_slots.id
Ref: timetable_entries.room_id > rooms.id

Ref: timetable_preferences.timetable_version_id > timetable_versions.id

Ref: lesson_occurrences.timetable_entry_id > timetable_entries.id

Ref: lesson_changes.lesson_occurrence_id > lesson_occurrences.id
Ref: lesson_changes.replacement_teacher_id > users.id
Ref: lesson_changes.replacement_room_id > rooms.id
Ref: lesson_changes.replacement_time_slot_id > time_slots.id
Ref: lesson_changes.created_by > users.id
Ref: lesson_changes.updated_by > users.id

// ========================================
// VZTAHY: CLASSBOOK
// ========================================

Ref: lesson_occurrences.id - classbook_entries.lesson_occurrence_id

Ref: classbook_entries.group_id > teaching_groups.id
Ref: classbook_entries.subject_id > subjects.id
Ref: classbook_entries.actual_teacher_id > users.id
Ref: classbook_entries.actual_room_id > rooms.id
Ref: classbook_entries.signed_by > users.id
Ref: classbook_entries.created_by > users.id
Ref: classbook_entries.updated_by > users.id

Ref: classbook_participants.classbook_entry_id > classbook_entries.id
Ref: classbook_participants.student_id > users.id
Ref: attendance_records.(classbook_entry_id, student_id) > classbook_participants.(classbook_entry_id, student_id)
Ref: attendance_records.excused_by > users.id
Ref: attendance_records.recorded_by > users.id

Ref: absence_excuse_requests.student_id > users.id
Ref: absence_excuse_requests.requested_by > users.id

Ref: absence_excuse_items.request_id > absence_excuse_requests.id
Ref: absence_excuse_items.attendance_record_id > attendance_records.id
Ref: absence_excuse_items.decided_by > users.id

// ========================================
// VIZUÁLNÍ ROZDĚLENÍ
// ========================================

TableGroup core_access {
  users
  roles
  permissions
  user_roles
  role_permissions
  auth_sessions
}

TableGroup core_audit {
  audit_events
}

TableGroup module_school {
  school_years
  specializations
  classes
  class_enrollments
  parent_students
  subjects

  group_divisions
  teaching_groups
  teaching_group_memberships
  group_specialization_rules
}

TableGroup module_rooms {
  room_types
  rooms
  group_home_rooms

  room_distance_models
  room_connections
  room_unavailability
}

TableGroup module_timetable {
  teaching_plans
  teaching_cycle_weeks
  teaching_cycle_steps
  teaching_plan_calendar_weeks
  teaching_plan_calendar_days
  teaching_assignment_weeks
  teaching_assignments
  teaching_blocks
  teaching_block_members
  teacher_unavailability

  time_grids
  time_slots

  timetable_versions
  timetable_entries
  timetable_preferences

  lesson_occurrences
  lesson_changes
}

TableGroup module_classbook {
  classbook_entries
  classbook_participants
  attendance_records
  absence_excuse_requests
  absence_excuse_items
}
