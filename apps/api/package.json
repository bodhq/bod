{
  "name": "@bod/api",
  "private": true,
  "scripts": {
    "dev": "uv run uvicorn server.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "python3 -m compileall server",
    "lint": "uv run ruff check server/ && uv run bandit -r server/ -c pyproject.toml",
    "openapi": "uv run python -m server.openapi ../../docs/openapi.json",
    "typecheck": "uv run mypy server/",
    "db:seed": "uv run python -m server.scripts.seed",
    "test": "uv run pytest"
  }
}
