{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",

  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!**/.turbo",
      "!**/.venv",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!apps/api/uv.lock",
      "!packages/api-client/src",
      "!docs/openapi.json"
    ]
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },

  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },

  "assist": {
  "actions": {
    "source": {
      "organizeImports": {
        "level": "on",
        "options": {
          "sortBareImports": true,
          "groups": [
            {
              "type": true
            },

            ":BLANK_LINE:",

            [
              ":NODE:",
              ":BUN:"
            ],

            ":BLANK_LINE:",

            [
              ":PACKAGE:",
              "!@/*",
              "!@repo/**",
              "!@/*/**"
            ],

            ":BLANK_LINE:",

            [
              ":ALIAS:"
            ],

            ":BLANK_LINE:",

            [
              ":PATH:",
              "!."
            ],

            ":BLANK_LINE:",

            [
              ":STYLE:"
            ],

            ":BLANK_LINE:",

            {
              "kind": "bare"
            }
          ]
        }
      }
    }
  }
},

  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },

  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
